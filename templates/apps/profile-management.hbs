<section class="rg-profile-management-body" data-rg-contract="profile-management-root">
  <header style="margin-bottom:14px;">
    <div style="font-size:.75em;text-transform:uppercase;letter-spacing:.08em;opacity:.75;">MG-FAMILY CORE · {{phase}}</div>
    <h2 style="margin:3px 0 4px;">Rules Profile Management</h2>
    <p style="margin:0;">Review the active profile, compare available rule models and preserve campaign data across profile changes.</p>
  </header>

  <section style="padding:12px;border:1px solid var(--color-border-light-tertiary);border-radius:6px;margin-bottom:12px;">
    <h3 style="margin:0 0 8px;">Active Rules Profile</h3>
    <div style="display:grid;grid-template-columns:1fr auto;gap:8px 16px;">
      <div><b>{{activeProfile.name}}</b><br><small>{{activeProfile.id}} · v{{activeProfile.version}}</small></div>
      <div style="text-align:right;"><b>{{activeProfile.activationState}}</b><br><small>{{activeProfile.classification}}</small></div>
    </div>
    <p><small>Rules snapshot: {{activeProfile.rulesSnapshotHash}}</small></p>
  </section>

  <section style="padding:12px;border:1px solid var(--color-border-light-tertiary);border-radius:6px;margin-bottom:12px;">
    <h3 style="margin:0 0 8px;">Available / Preview Profiles</h3>
    <div style="padding:12px 0;border-bottom:1px solid rgba(128,128,128,.22);" data-rg-contract="profile-tb2e-foundation">
      <b>Torchbearer 2E · Rules / Creation Profile v1</b>
      <p>FOUNDATION_ONLY / READ_ONLY · M10D.1. The available guides are incomplete. Review source coverage; live activation and creation remain locked.</p>
      <button type="button" data-action="previewTb2e" data-rg-contract="profile-preview-tb2e">Preview TB2E Source Coverage / Conversion</button>
    </div>

    <div style="padding:8px 0 12px;border-bottom:1px solid rgba(128,128,128,.22);">
      <div style="display:grid;grid-template-columns:1fr auto;gap:8px 16px;">
        <div><b>{{strictProfile.name}}</b><br><small>{{strictProfile.sourceLineage}}</small></div>
        <div style="text-align:right;"><b>{{strictProfile.activationState}}</b><br><small>v{{strictProfile.version}}</small></div>
      </div>
      <p><small>Rules snapshot: {{strictProfile.rulesSnapshotHash}}</small></p>
      <button type="button" data-action="previewStrict" data-rg-contract="profile-preview-strict" {{#unless previewAvailable}}disabled{{/unless}}>
        <i class="fa-solid fa-magnifying-glass-chart"></i> Preview Strict Conversion
      </button>
    </div>

    <div style="padding:12px 0;border-bottom:1px solid rgba(128,128,128,.22);">
      <div style="display:grid;grid-template-columns:1fr auto;gap:8px 16px;">
        <div><b>{{mg1eProfile.name}}</b><br><small>{{mg1eProfile.sourceLineage}}</small></div>
        <div style="text-align:right;"><b>{{mg1eProfile.activationState}}</b><br><small>v{{mg1eProfile.version}}</small></div>
      </div>
      <p><small>{{mg1eProfile.classification}} · Rules snapshot: {{mg1eProfile.rulesSnapshotHash}}</small></p>
      <button type="button" data-action="previewMg1e" data-rg-contract="profile-preview-mg1e" {{#unless previewAvailable}}disabled{{/unless}}>
        <i class="fa-solid fa-magnifying-glass-chart"></i> Preview MG1E Conversion
      </button>
      <p style="margin-bottom:0;"><small>Mouse Guard 1E remains QA-selectable; stable runtime keeps its activation gate closed.</small></p>
    </div>

    <div style="padding:12px 0 2px;">
      <div style="display:grid;grid-template-columns:1fr auto;gap:8px 16px;">
        <div><b>{{mg2eProfile.name}}</b><br><small>{{mg2eProfile.sourceLineage}}</small></div>
        <div style="text-align:right;"><b>{{mg2eProfile.activationState}}</b><br><small>v{{mg2eProfile.version}}</small></div>
      </div>
      <p><small>{{mg2eProfile.classification}} · Rules snapshot: {{mg2eProfile.rulesSnapshotHash}}</small></p>
      <button type="button" data-action="previewMg2e" data-rg-contract="profile-preview-mg2e" {{#unless mg2eProfile.conversionPreviewAvailable}}disabled{{/unless}}>
        <i class="fa-solid fa-magnifying-glass-chart"></i> Preview MG2E Conversion
      </button>
      <p style="margin-bottom:0;"><small>Mouse Guard 2E is now QA-selectable after verified controlled parity. Switching changes only the active profile settings; existing Wises, inventory, Conditions and provenance are preserved. Stable builds keep the MG2E activation gate closed.</small></p>
    </div>
  </section>

  <section style="padding:12px;border:1px solid var(--color-border-light-tertiary);border-radius:6px;margin-bottom:12px;">
    <h3 style="margin:0 0 8px;">World Impact Snapshot</h3>
    {{#each impactRows}}
      <div style="display:flex;justify-content:space-between;gap:12px;padding:4px 0;border-bottom:1px solid rgba(128,128,128,.16);">
        <span>{{label}}</span><b>{{value}}</b>
      </div>
    {{/each}}
    <p style="margin-bottom:0;"><small>This is an impact scan only. Hidden or inactive profile data is preserved, not deleted.</small></p>
  </section>

  <section style="padding:12px;border:1px solid var(--color-border-light-tertiary);border-radius:6px;">
    <h3 style="margin:0 0 8px;">Rules Profile Activation</h3>
    {{#each activationRows}}
      <div style="padding:8px 0;border-bottom:1px solid rgba(128,128,128,.16);">
        <div style="display:grid;grid-template-columns:1fr auto;gap:8px 16px;">
          <div><b>{{name}}</b><br><small>{{id}} · v{{version}}</small></div>
          <div style="text-align:right;"><b>{{activationState}}</b></div>
        </div>
        {{#if active}}
          <p style="margin-bottom:0;"><small>This profile is currently active.</small></p>
        {{else if canActivate}}
          <button type="button" data-action="switchProfile" data-profile-id="{{id}}" data-rg-contract="profile-switch-supported">
            <i class="fa-solid fa-scale-balanced"></i> Switch to {{name}}
          </button>
        {{else}}
          <p style="margin-bottom:0;"><small><i class="fa-solid fa-lock"></i> {{lockedReason}}</small></p>
        {{/if}}
      </div>
    {{/each}}
    {{#if canSwitchLegacy}}
      <p><b>Rollback remains available.</b> Returning to Legacy Mixed changes only profile settings and preserves profile-specific data.</p>
      <button type="button" data-action="switchLegacy" data-rg-contract="profile-switch-legacy">
        <i class="fa-solid fa-rotate-left"></i> Switch back to Legacy Mixed
      </button>
    {{/if}}
    <p style="margin-bottom:0;" data-rg-contract="profile-switch-reload-guidance"><small>{{nextStep}}. Reload the world after every supported profile switch.</small></p>
  </section>
</section>
